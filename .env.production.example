DJANGO_SECRET_KEY=aid-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.aid-ai.uz,localhost,127.0.0.1
DJANGO_COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_SAMESITE=None
DJANGO_CSRF_COOKIE_SAMESITE=None
DJANGO_STATIC_URL=/static/
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false

POSTGRES_DB=aid_healthcare
POSTGRES_USER=aid
POSTGRES_PASSWORD=aid-strong-password
DATABASE_URL=postgres://aid:aid-strong-password@db:5432/aid_healthcare
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.aid-ai.uz

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_ASSISTANT_ENABLED=true

AID_RUN_MIGRATIONS=true
AID_COLLECTSTATIC=true
HTTP_PORT=80

NEXT_PUBLIC_API_BASE_URL=https://api.aid-ai.uz/api
NEXT_PUBLIC_WS_BASE_URL=wss://api.aid-ai.uz
